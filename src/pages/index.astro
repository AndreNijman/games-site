---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import GameCard from "../components/GameCard.astro";
import Ads from "../components/Ads.astro";
import { GAMES, FEATURED, gameUrl, artPath } from "../data/games";
import { ORDERED, ORDER_SOURCE } from "../data/hub-order";

const ORIGIN = "https://games.andrenijman.com/";
const title = "Games by Andre Nijman · free browser games";
const description = "Free browser games by Andre Nijman: original games and credited open-source projects, including ONE WORLD, TOPOUT, OVERPOP, Wildbound.io, and more.";
const ogDescription = "Free browser games spanning competitive puzzling, tower defense, survival, sandbox adventure, horror, and roguelikes. Nothing to download.";
const twitterDescription = "Free browser games spanning competitive puzzling, tower defense, survival, sandbox adventure, horror, and roguelikes.";

const collection = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Games by Andre Nijman",
  url: ORIGIN,
  description: "Free original browser games and clearly credited open-source game projects curated by Andre Nijman.",
  author: { "@type": "Person", name: "Andre Nijman", url: "https://andrenijman.com/" },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: ORDERED.map((g, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "VideoGame",
        name: g.name,
        url: gameUrl(g),
        description: g.description,
        genre: g.genre,
        gamePlatform: "Web browser",
        ...(g.author && { author: g.author }),
        ...(g.isBasedOn && { isBasedOn: g.isBasedOn }),
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      },
    })),
  },
};
const site = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${ORIGIN}#website`,
      name: "Games by Andre Nijman",
      url: ORIGIN,
      inLanguage: "en",
      publisher: { "@id": "https://andrenijman.com/#person" },
    },
    {
      "@type": "Person",
      "@id": "https://andrenijman.com/#person",
      name: "Andre Nijman",
      url: "https://andrenijman.com/",
      sameAs: ["https://github.com/AndreNijman", ORIGIN],
    },
  ],
};
---
<Base path="/" title={title} description={description} ads>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Games by Andre Nijman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ORIGIN} />
    <meta property="og:image" content={`${ORIGIN}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Games by Andre Nijman" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={`${ORIGIN}og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(collection, null, 2)} />
    <script type="application/ld+json" set:html={JSON.stringify(site, null, 2)} />
  </Fragment>

  <Header />

  <main id="main" tabindex="-1">
    <div class="hero">
      <div class="wrap hero__grid">
        <div>
          <p class="label">The browser is your playground</p>
          <h1>Hop on<br /><em>the games.</em></h1>
          <p class="lede">A little collection of big distractions. Original games, friends’ creations, and credited open-source projects. All free. Pick one and play.</p>
          <div class="btnrow">
            <a class="btn" href="#games">Find your next game ↓</a>
          </div>
        </div>
        <a class="hero__art" href={gameUrl(FEATURED)} aria-label={FEATURED.label}>
          <img class="sticker" src={artPath(FEATURED.image)} width="1400" height="735" fetchpriority="high" alt={FEATURED.alt} />
          <span class="hero__cap">{FEATURED.cap}</span>
        </a>
      </div>
    </div>

    <div class="strip strip--three">
      <div><b>{GAMES.length}</b><span>games to get lost in</span></div>
      <div><b>$0</b><span>to play</span></div>
      <div><b>0</b><span>things to install</span></div>
    </div>

    <aside class="ad-inline" id="ad-leaderboard" aria-label="Advertisement" hidden>
      <div class="wrap">
        <p class="ad-label">Advertisement</p>
        <div class="ad-host" id="ad-leaderboard-host"></div>
      </div>
    </aside>

    <section id="games" aria-labelledby="games-heading">
      <div class="wrap">
        <div class="section-head">
          <p class="label">The games</p>
          <h2 id="games-heading">Pick your kind of chaos.</h2>
          <p>Solo adventures. Friendly competition. One more round.</p>
        </div>
        <div class="finder" id="finder" role="search" aria-label="Find a game" hidden>
          <input class="finder__q" id="games-q" type="search" placeholder="Search by name or genre" aria-label="Search the games" autocomplete="off" spellcheck="false" />
          <div class="finder__sort" role="group" aria-label="Sort the games">
            <button type="button" data-sort="popular" aria-pressed="true">Popular</button>
            <button type="button" data-sort="name" aria-pressed="false">A–Z</button>
            <button type="button" data-sort="genre" aria-pressed="false">Genre</button>
          </div>
          <p class="finder__count" id="games-count" role="status"></p>
        </div>
        <div class="games" data-order={ORDER_SOURCE}>
          {ORDERED.map((game, i) => <GameCard game={game} eager={i < 3} />)}
        </div>
        <p class="games-none" id="games-none" hidden>Nothing matches that. <button type="button" class="nav-link" id="games-clear">Clear the search</button></p>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span><a href="https://andrenijman.com">andrenijman.com</a> &nbsp;·&nbsp; <a href="https://github.com/AndreNijman">GitHub</a> &nbsp;·&nbsp; <a href="/_guard/privacy">Privacy &amp; ads</a></span>
      <span class="muted">&copy; 2026 Andre Nijman · originals and credited open source</span>
    </div>
  </footer>

  <Ads />

  <script>
    // Sort and search the cards. The build's order is "Popular"; a different
    // order or a search moves and hides the cards, then lays out the wide ones
    // again with the build's rule (layout() in order.ts) so no row is left open.
    import { layout } from "../data/order";

    const finder = document.getElementById("finder")!;
    const grid = document.querySelector<HTMLElement>("#games .games")!;
    const q = document.getElementById("games-q") as HTMLInputElement;
    const count = document.getElementById("games-count")!;
    const none = document.getElementById("games-none")!;
    const buttons = [...finder.querySelectorAll<HTMLButtonElement>("[data-sort]")];
    const cards = [...grid.querySelectorAll<HTMLElement>(".game")];
    // lower case, no accents, words only: each search term has to start a word
    const fold = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();
    const name = new Map(cards.map((c) => [c, c.querySelector("h3")!.textContent!.trim()]));
    const genre = new Map(cards.map((c) => [c, c.dataset.genre ?? ""]));
    const text = new Map(cards.map((c) => [c, ` ${fold(c.textContent ?? "")}`]));
    const byName = (a: HTMLElement, b: HTMLElement) => name.get(a)!.localeCompare(name.get(b)!, "en", { sensitivity: "base", numeric: true });
    const sorts: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      name: byName,
      genre: (a, b) => genre.get(a)!.localeCompare(genre.get(b)!, "en") || byName(a, b),
    };
    let sort = "popular";

    function apply() {
      const terms = fold(q.value).split(" ").filter(Boolean);
      const ordered = sorts[sort] ? [...cards].sort(sorts[sort]) : cards;
      const shown = ordered.filter((c) => terms.every((t) => text.get(c)!.includes(` ${t}`)));
      const wides = layout(shown.map(() => ({})));
      for (const c of ordered) {
        c.hidden = !shown.includes(c);
        c.classList.remove("game--wide", "game--wide-lg");
        grid.append(c);
      }
      shown.forEach((c, i) => {
        const w = wides[i].wide;
        if (w) c.classList.add(w === "all" ? "game--wide" : "game--wide-lg");
      });
      none.hidden = shown.length > 0;
      count.textContent = terms.length ? `${shown.length} of ${cards.length} games` : `${cards.length} games`;
    }

    for (const b of buttons) {
      b.addEventListener("click", () => {
        sort = b.dataset.sort!;
        for (const o of buttons) o.setAttribute("aria-pressed", String(o === b));
        apply();
      });
    }
    q.addEventListener("input", apply);
    document.getElementById("games-clear")!.addEventListener("click", () => { q.value = ""; apply(); q.focus(); });
    count.textContent = `${cards.length} games`;
    finder.hidden = false;
  </script>

  <script is:inline>
    (function () {
      function render(status) {
        if (!status) return;
        if (status.signedIn && status.username) {
          document.getElementById('account-name').textContent = status.username;
          document.getElementById('account').hidden = false;
        } else {
          document.getElementById('nav-signin').hidden = false;
        }
      }
      if (window.__gamesGuardStatus) {
        render(window.__gamesGuardStatus);
        return;
      }
      var statusMeta = document.querySelector('meta[name="games-guard-status"]');
      if (statusMeta) {
        try {
          render(JSON.parse(statusMeta.content));
          return;
        } catch (error) {}
      }
      fetch('/_guard/status', { cache: 'no-store', credentials: 'same-origin' })
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(render)
        .catch(function () {});
    }());
  </script>
</Base>
